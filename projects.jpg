972587\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"userID\",\"value\":{\"prompt\":\"The user provided feedback on a previous completion. Use it to generate a new completion. The output should be a standalone response that reflects the feedback without acknowledging it. Do not mention, suggest, or imply that this is a revision, improvement, or result of feedback. Respond in the same language as the original completion, even if the feedback is in another language. Only switch if the feedback explicitly asks you to translate the completion. Here is the feedback:\\n\"},\"is_device_based\":false,\"passed\":false},\"3595907841\":{\"name\":\"3595907841\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[{\"gate\":\"3097504420\",\"gateValue\":\"true\",\"ruleID\":\"EucMssgnC96MVvOhTzZYO\"}],\"version\":27,\"id_type\":\"userID\",\"value\":{\"show_banner\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"3608673692\":{\"name\":\"3608673692\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"userID\",\"value\":{\"sse_first_response_warning_ms\":120000,\"sse_initial_open_timeout_ms\":0,\"sse_between_bytes_timeout_ms\":60000},\"is_device_based\":false,\"passed\":false},\"3646412386\":{\"name\":\"3646412386\",\"rule_id\":\"nR03hMjrP77cIXMn3AGYf:100.00:6-nR03g7gZwXCTjpQLVF3Fd\",\"secondary_exposures\":[],\"version\":40,\"id_type\":\"userID\",\"value\":{\"enabled\":true,\"hover_delay_ms\":100,\"ttl_seconds\":900,\"max_pages\":10},\"is_device_based\":false,\"passed\":true},\"3685705952\":{\"name\":\"3685705952\",\"rule_id\":\"2iM40zAnB3wf9IPQaVNA59-2iM40xVl8LmKQjhUzNRWM7\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"userID\",\"value\":{\"sms\":[\"US\",\"CA\",\"JP\",\"KR\",\"FR\",\"TW\",\"TH\",\"FK\",\"NU\",\"TL\",\"VU\",\"SM\"],\"whatsapp\":[\"IN\",\"CO\",\"GB\",\"BR\",\"MX\",\"AR\",\"DE\",\"SE\",\"HU\",\"PH\",\"AU\",\"CZ\",\"IQ