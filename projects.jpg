eet" type="text/css" href="./projects_files/f813678c40c7.css"><link rel="stylesheet" type="text/css" href="./projects_files/e10676d91e95.css"><link rel="stylesheet" type="text/css" href="./projects_files/18ad5d9adcf9.css"><link rel="stylesheet" type="text/css" href="./projects_files/e5137e2f86fe.css"><link rel="stylesheet" type="text/css" href="./projects_files/719373828107.css"><link rel="stylesheet" type="text/css" href="./projects_files/f61db5427555.css"><link rel="stylesheet" type="text/css" href="./projects_files/245122e996d9.css"><link rel="stylesheet" type="text/css" href="./projects_files/a0327f06c888.css"><meta http-equiv="origin-trial" content="AnY33Lstn7fSTXvj63Z4glPcRXtUukuM9rLN87JGOugFyfum9ckNUU3NYHeRLcp6TELT5wbCZih5SlHfumMbJAkAAABmeyJvcmlnaW4iOiJodHRwczovL2NoYXRncHQuY29tOjQ0MyIsImZlYXR1cmUiOiJXZWJSdGNTY3RwU25hcCIsImV4cGlyeSI6MTc5NDg3MzYwMCwiaXNTdWJkb21haW4iOnRydWV9"><link rel="stylesheet" type="text/css" href="./projects_files/b7eab0952b73.css"><link rel="stylesheet" type="text/css" href="./projects_files/5542d09e1b11.css"><link rel="stylesheet" type="text/css" href="./projects_files/edcaf5e544dc.css"><link rel="stylesheet" type="text/css" href="./projects_files/aa0a701ac0d0.css"><link rel="stylesheet" type="text/css" href="./projects_files/1becd3d84910.css"><link rel="stylesheet" type="text/css" href="./projects_files/a3a76ffc5dc9.css"><link rel="stylesheet" type="text/css" href="./projects_files/f3c5bce0834c.css"><link rel="stylesheet" type="text/css" href="./projects_files/12b304230ada.css"><link rel="stylesheet" type="text/css" href="./projects_files/48ceca04bca6.css"><link rel="stylesheet" type="text/css" href="./projects_files/92a9a18ef2b4.css"><link rel="stylesheet" type="text/css" href="./projects_files/5a7fee8bc017.css"><link rel="stylesheet" type="text/css" href="./projects_files/373f0a373a00.css"><link rel="stylesheet" type="text/css" href="./projects_files/13ed6b6971c9.css"><link rel="stylesheet" type="text/css" href="./projects_files/dac6b84805a2.css"><link rel="stylesheet" type="text/css" href="./projects_files/49afccbac600.css"><link rel="stylesheet" type="text/css" href="./projects_files/261bbec92f8e.css"><link rel="stylesheet" type="text/css" href="./projects_files/af120da63057.css"></head><body style="--font-ui-size: 16px; --text-4xl: 36px; --text-3xl: 30px; --text-2xl: 24px; --text-xl: 20px; --text-lg: 18px; --text-base: 16px; --text-sm: 14px; --text-xs: 12px; --text-dynamic-isle-row: 14px; --text-heading-lg: 24px; --text-heading-app: 28px; --text-heading-md: 20px; --text-heading-sm: 18px;"><script nonce="">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    claimAttachmentNotification: (expected) => {
      if (!launch || launch.snapshot !== expected || launch.attachmentNotified) return false;
      launch.attachmentNotified = true;
      save();
      return true;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();
