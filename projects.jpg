tant" data-chatgpt-search-message-ids="ae844c0a-fb28-40e4-8a5f-833d9c2aa9ec ae844c0a-fb28-40e4-8a5f-833d9c2aa9ec"><h4 class="sr-only m-0 select-none print:not-sr-only print:mt-4 print:mb-2 print:text-xs print:leading-normal print:font-bold print:group-data-[print-formatting]/conversation-print:mt-6 print:group-data-[print-formatting]/conversation-print:font-normal print:group-data-[print-formatting]/conversation-print:text-secondary" data-conversation-role="assistant" tabindex="-1"><span class="print:group-data-[print-formatting]/conversation-print:sr-only">ChatGPT said:</span><span class="hidden print:group-data-[print-formatting]/conversation-print:inline" aria-hidden="true">ChatGPT</span></h4><div><div class="group flex min-w-0 flex-col" data-chatgpt-selection-conversation-id="6aac3d93-baa4-83ea-a65c-b57fde3751f2" data-chatgpt-selection-message-id="ae844c0a-fb28-40e4-8a5f-833d9c2aa9ec"><span hidden=""></span><div data-selected-text-overlay-target="_r_iun_" dir="auto" data-markdown-text-style="assistant-message" class="MarkdownRoot-rZKhxa [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 [&amp;&gt;*:last-child]:mb-0 [&amp;&gt;ol:first-child]:mt-0 [&amp;&gt;ul:first-child]:mt-0" style="--markdown-link-color: currentColor;"><div class="my-4 first:mt-0 last:mb-0 empty:hidden" data-dil-source-message-id="ae844c0a-fb28-40e4-8a5f-833d9c2aa9ec" data-chatgpt-copy-reference="0" data-markdown-copy="contents"><div class="[--entity-prose-inset:0px]"><div hidden=""></div><div class="relative PortalBoundary-TFj9W2 Renderer-ojZscX" data-theme="dark" style="--puik-portal-zoom: 1;"><div dir="auto" class="DilRenderer-tB76Jj DilResponseRoot-HfQrEh Reveal-k2IWvM" data-d-direction="col" data-dil-message-id="ae844c0a-fb28-40e4-8a5f-833d9c2aa9ec"><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">I recommend </span><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">4 pictures</span></span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"> for your P4 website, one for each homepage card.</span></p><ol class="List-rH8nmc" data-d-component="list" data-d-marker="number" data-d-marker-layout="native" style="--d-list-row-gap: calc(var(--spacing, 0.25rem) * 0); gap: calc(var(--spacing, 0.25rem) * 0);"><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-text-flow="run">Education</span></span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"> — NJIT campus</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">Experience</span></span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"> — Professional office</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">Skills</span></span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"> — Computer programming</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">Projects</span></span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"> — Website development</span></p></div></div></li></ol><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">Your professor recommends </span><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">3 or more pictures if possible</span></span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">, but does not strictly require four.</span></p><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">My recommendation: Upload all 4 pictures</span></span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"> to your GitHub </span><code class="Code-kbs71c" data-d-component="code"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">images</span></code><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"> folder. Then we'll add them to your homepage with </span><code class="Code-kbs71c" data-d-component="code"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">alt</span></code><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"> tags.</span></p></div></div></div><div class="contents"></div></div></div></div></div></div><span hidden=""></span></div></div><div class="actionRow-nqqZbm mt-1.5 flex turn-action-controls min-h-5 min-w-0 max-w-(--thread-content-max-width) flex-wrap items-center justify-start gap-0.5 browser:-ms-0.5 browser:mt-3 electron:-translate-x-1 extension:-translate-x-1.5 [&amp;_button]:focus-visible:ring-2 [&amp;_button]:focus-visible:ring-ring [&amp;_button]:focus-visible:ring-offset-0 [--side-tooltip:bottom]"><div class="flex min-h-5 min-w-0 flex-wrap items-center gap-0.5 browser:gap-0"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full electron:rounded-md text-tertiary not-disabled:not-aria-disabled:hover:bg-primary-ghost-hover data-[state=open]:bg-primary-ghost-hover border-transparent electron:p-1 button-icon flex items-center justify-center p-0.5" aria-label="Copy" data-state="closed"><svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-xs"><path d="M13.468