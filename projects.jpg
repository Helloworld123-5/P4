ding@openai-curated-remote\",\"chatgpt-teams@openai-curated-remote\",\"plugin_connector_1p_26fe5acfb444819196d4ca753923a36d\",\"botmail@openai-curated-remote\",\"visualize@openai-bundled\",\"visualize@openai-curated-remote\",\"plugin_connector_1p_e27075fa9af48191968b90b68ab08ba3\",\"plugin_asdk_app_6a57c10d60ac81918c1afd8239c136e1\",\"dev-6a57c10d60ac81918c1afd8239c136e1@workspace-directory\"]},\"is_device_based\":false,\"passed\":false},\"1408180753\":{\"name\":\"1408180753\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{\"base_interval_ms\":60000,\"poll_in_background\":false,\"usage_scaling_multiplier\":0},\"is_device_based\":false,\"passed\":false},\"1435569120\":{\"name\":\"1435569120\",\"rule_id\":\"layerAssignment\",\"secondary_exposures\":[{\"gate\":\"1192462084\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1506791903\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":7,\"id_type\":\"userID\",\"value\":{\"enabled\":false},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"enabled\"],\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"1514783977\":{\"name\":\"1514783977\",\"rule_id\":\"5c7eTqPcr04kHs62StVEE7\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"userID\",\"value\":{\"show_task\":true},\"is_device_based\":false,\"group_name\":\"Visible\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"1546790766\":{\"name\":\"1546790766\",\"rule_id\":\"6so2zzLvnKjM8SVDWwSyz7:100.00:16-6so2zy6sVsahPtnIloWVg5\",\"secondary_exposures\":[{\"gate\":\"2876266821\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"324099391\",\"gateValue\":\"true\",\"ruleID\":\"34ViavtVWO2VM8tWIWLFHn:100.00:2\"},{\"gate\":\"1033995237\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"225888775\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3539777877\",\"gateValue\":\"false\",\"ruleID\":\"2P7rzuCnrrJe6VUn9e4Xjm\"},{\"gate\":\"2185729796\",\"gateValue\":\"true\",\"ruleID\":\"3y7YscCJMHMsD93OnMlvfY:100.00:6\"}],\"version\":48,\"id_type\":\"userID\",\"value\":{\"health_v3_tabs\":{\"tab_order\":[\"home\",\"chats\",\"records\",\"accounts\"],\"records\":{\"ecosystem_view_slug\":\"recordsTimeline\",\"visible\":true},\"home\":{\"visible\":true,\"ecosystem_view_slug\":\"home\"},\"chats\":{\"visible\":true},\"accounts\":{\"visible\":true,\"ecosystem_view_slug\":\"connections\"}},\"health_v3_starter_prompts_enabled\":true,\"enabled\":true},\"is_device_based\":false,\"passed\":true},\"1557207450\":{\"name\":\"1557207450\",\"rule_id\":\"32VPyPp1Jc3m46RrYpe2pc\",\"secondary_exposures\":[{\"gate\":\"1192462084\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1506791903\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":9,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"enabled\"],\"group_name\":\"Treatment\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"1571275116\":{\"name\":\"1571275116\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"userID\",\"value\":{\"migration_cutoff\":\"2026-10-29T18:00:00Z\",\"enabled\":true},\"is_device_based\":false,\"passed\":false},\"1571655448\":{\"name\":\"1571655448\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":211,\"id_type\":\"stableID\",\"value\":{\"enabled\":false,\"presence_cache_write_timeout_ms\":3000,\"heartbeat_seconds\":15,\"push_pending_capacity\":4096,\"polling_seconds_if_stream_enabled\":3600,\"publisher_workers\":32,\"publish_timeout_ms\":5000,\"client_stream_stable_ms\":30000,\"balance_owner_account_limit\":500,\"client_stream_initial_timeout_ms\":45000,\"presence_cache_read_timeout_ms\":2000,\"client_stream_rotation_ms\":1680000,\"presence_renewal_seconds\":1800,\"push_snapshot_interval_seconds\":5,\"presence_ttl_seconds\":3600,\"rpc_timeout_ms\":5000,\"workspace_broadcast